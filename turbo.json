{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": [
    "**/.env.*local",
    ".env"
  ],
  "globalEnv": [
    "NODE_ENV",
    "VERCEL_URL"
  ],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [
        ".next/**",
        "!.next/cache/**",
        "dist/**",
        "build/**"
      ],
      "env": [
        "MONGODB_URI",
        "NEXT_PUBLIC_APP_URL",
        "NEXT_PUBLIC_API_URL",
        "SPORTUP_OIDC_ISSUER",
        "SPORTUP_OIDC_CLIENT_ID",
        "SPORTUP_OIDC_CLIENT_SECRET",
        "PAYMENT_24PAY_MERCHANT_ID",
        "PAYMENT_24PAY_SECRET",
        "PAYMENT_24PAY_API_URL",
        "MUX_TOKEN_ID",
        "MUX_TOKEN_SECRET",
        "RESEND_API_KEY",
        "SENTRY_DSN"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "outputs": ["coverage/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "clean": {
      "cache": false
    }
  }
}

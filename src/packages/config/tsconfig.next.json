{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "ClubUp Next.js TS config",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "noEmit": true,
    "allowJs": true,
    "plugins": [{ "name": "next" }]
  }
}

{
  "name": "@clubup/doc",
  "version": "0.0.0",
  "private": true,
  "description": "ClubUp documentation site — docs.clubup.sk. Nextra 4 over Next.js 15. Source of truth lives in /docs at repo root; the prebuild script mirrors it into ./content.",
  "license": "EUPL-1.2",
  "type": "module",
  "scripts": {
    "predev": "node scripts/mirror-content.mjs",
    "dev": "next dev --port 3003",
    "prebuild": "node scripts/mirror-content.mjs",
    "build": "next build",
    "postbuild": "pagefind --site .next/server/app --output-path public/_pagefind || true",
    "start": "next start --port 3003",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf .next content public/_pagefind"
  },
  "dependencies": {
    "next": "^15.1.0",
    "nextra": "^4.6.0",
    "nextra-theme-docs": "^4.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@clubup/config": "*",
    "@types/node": "^20.16.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "pagefind": "^1.1.1",
    "typescript": "^5.6.3"
  }
}

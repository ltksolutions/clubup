#
# Copy to .env.local and fill in. NEVER commit .env.local.

# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clubup_dev

# === Auth (SportUp OIDC) — admin app may use a separate client_id ===
SPORTUP_OIDC_ISSUER=http://localhost:9000
SPORTUP_OIDC_CLIENT_ID=dev-admin-client
SPORTUP_OIDC_CLIENT_SECRET=dev-admin-secret

AUTH_SECRET=replace-me-with-32-random-bytes-base64
AUTH_URL=http://localhost:3001

# === Mock IdP — admin user roles ===
MOCK_USER_ID=sportup_person_id_dev_admin
MOCK_USER_NAME=Admin Test
MOCK_USER_EMAIL=admin@dev.local
MOCK_USER_ROLES=clubup:admin,clubup:content_manager

# === Mux (admin uploads videos) ===
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=

# === Microsoft Graph (Teams webinars — Phase 2) ===
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
MS_GRAPH_USER_ID=

# === Public (exposed to browser) ===
NEXT_PUBLIC_APP_URL=http://localhost:3001

#
# Copy to .env.local and fill in. NEVER commit .env.local.
# Production values come from Vercel Environment Variables.

# === MongoDB ===
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=clubup_dev

# === Auth (SportUp OIDC) ===
# In dev: point to local mock IdP (npm run mock-idp --workspace=@clubup/auth)
SPORTUP_OIDC_ISSUER=http://localhost:9000
SPORTUP_OIDC_CLIENT_ID=dev-client
SPORTUP_OIDC_CLIENT_SECRET=dev-secret

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=replace-me-with-32-random-bytes-base64
AUTH_URL=http://localhost:3000

# === Mock IdP (dev only) ===
MOCK_USER_ID=sportup_person_id_dev_001
MOCK_USER_NAME=Mária Dev Testovacia
MOCK_USER_EMAIL=maria@dev.local
MOCK_USER_ROLES=clubup:student

# === Payments (24-pay test mode) ===
PAYMENT_24PAY_MERCHANT_ID=test-merchant
PAYMENT_24PAY_SECRET=test-secret-replace-me
PAYMENT_24PAY_API_URL=https://test.24-pay.sk/api

# === Video (Mux) ===
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_SECRET=

# === Email (Resend) ===
RESEND_API_KEY=

# === Public (exposed to browser) ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
